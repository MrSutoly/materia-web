@host = http://localhost:3000

# COMO USAR
# - Extensao recomendada: REST Client (humao.rest-client) no VS Code.
# - Para uma sequencia correta, apague o arquivo biblioteca.sqlite antes de iniciar a API
#   (assim os dados iniciais ficam como no enunciado: 5 livros, 5 leitores, 0 emprestimos).
# - Execute as requisicoes de cima para baixo, uma por vez ("Send Request").
# - Os ids novos sao lidos automaticamente das respostas anteriores.

###############################################################
# 1. AUTORES
###############################################################

### Listar autores (200)
GET {{host}}/autores

### Cadastrar autor (201)
# @name novoAutor
POST {{host}}/autores
Content-Type: application/json

{
  "nome": "Machado de Assis"
}

### Cadastrar autor sem nome (400)
POST {{host}}/autores
Content-Type: application/json

{}

###############################################################
# 2. CATEGORIAS
###############################################################

### Listar categorias (200)
GET {{host}}/categorias

### Cadastrar categoria (201)
# @name novaCategoria
POST {{host}}/categorias
Content-Type: application/json

{
  "nome": "Romance"
}

### Cadastrar categoria sem nome (400)
POST {{host}}/categorias
Content-Type: application/json

{}

###############################################################
# 3. LIVROS
###############################################################

### Listar todos os livros (200)
GET {{host}}/livros

### Filtro por categoria (200)
GET {{host}}/livros?categoria=Ficção científica

### Filtro por autor (200)
GET {{host}}/livros?autor=Frank Herbert

### Filtro por categoria e autor juntos (200)
GET {{host}}/livros?categoria=Filosofia&autor=Platão

### Filtro de disponiveis (200)
GET {{host}}/livros?disponivel=true

### Filtro invalido (400)
GET {{host}}/livros?disponivel=talvez

### Detalhe do livro com autor e categoria (200)
GET {{host}}/livros/1

### Livro inexistente (404)
GET {{host}}/livros/999

### Id invalido (400)
GET {{host}}/livros/abc

### Cadastrar livro (201)
# @name novoLivro
POST {{host}}/livros
Content-Type: application/json

{
  "titulo": "Dom Casmurro",
  "exemplares": 2,
  "autorId": {{novoAutor.response.body.dados.id}},
  "categoriaId": {{novaCategoria.response.body.dados.id}}
}

### Cadastrar livro com exemplares zero (400)
POST {{host}}/livros
Content-Type: application/json

{
  "titulo": "Livro invalido",
  "exemplares": 0,
  "autorId": 1,
  "categoriaId": 1
}

### Cadastrar livro com autor inexistente (404)
POST {{host}}/livros
Content-Type: application/json

{
  "titulo": "Livro sem autor",
  "exemplares": 1,
  "autorId": 999,
  "categoriaId": 1
}

### Cadastrar livro com categoria inexistente (404)
POST {{host}}/livros
Content-Type: application/json

{
  "titulo": "Livro sem categoria",
  "exemplares": 1,
  "autorId": 1,
  "categoriaId": 999
}

### Alterar livro (200)
PATCH {{host}}/livros/{{novoLivro.response.body.dados.id}}
Content-Type: application/json

{
  "exemplares": 4
}

### Alterar livro inexistente (404)
PATCH {{host}}/livros/999
Content-Type: application/json

{
  "exemplares": 4
}

### Alterar livro com dado invalido (400)
PATCH {{host}}/livros/{{novoLivro.response.body.dados.id}}
Content-Type: application/json

{
  "exemplares": -1
}

###############################################################
# 4. LEITORES
###############################################################

### Cadastrar leitor (201)
POST {{host}}/leitores
Content-Type: application/json

{
  "nome": "Fernanda Costa",
  "matricula": "2024100",
  "email": "fernanda.costa@exemplo.com"
}

### Cadastrar leitor com e-mail invalido (400)
POST {{host}}/leitores
Content-Type: application/json

{
  "nome": "Fulano",
  "matricula": "2024101",
  "email": "email-invalido"
}

### Cadastrar leitor com matricula repetida (409)
POST {{host}}/leitores
Content-Type: application/json

{
  "nome": "Outra Pessoa",
  "matricula": "2024001",
  "email": "outra.pessoa@exemplo.com"
}

###############################################################
# 5. EMPRESTIMOS
# Leitores iniciais: 1 a 5. Livros iniciais: 1 a 5 (3 exemplares cada).
###############################################################

### R1 (parte 1): leitor 1 pega o livro 1 (201)
# R3: confira que dataPrevista = dataRetirada + 14 dias
# @name emprestimo1
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 1,
  "leitorId": 1
}

### R1 (parte 2): leitor 2 pega o livro 1 (201)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 1,
  "leitorId": 2
}

### R1 (parte 3): leitor 3 pega o livro 1 (201) - terceiro e ultimo exemplar
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 1,
  "leitorId": 3
}

### R1 ERRO: leitor 4 tenta o livro 1 sem exemplar (409 SEM_EXEMPLAR)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 1,
  "leitorId": 4
}

### R2 (parte 1): leitor 5 pega o livro 2 (201)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 2,
  "leitorId": 5
}

### R2 (parte 2): leitor 5 pega o livro 3 (201)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 3,
  "leitorId": 5
}

### R2 (parte 3): leitor 5 pega o livro 4 (201) - terceiro emprestimo em aberto
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 4,
  "leitorId": 5
}

### R2 ERRO: leitor 5 tenta o quarto emprestimo (409 LIMITE_EMPRESTIMOS)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 5,
  "leitorId": 5
}

### Emprestimo com livro inexistente (404)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 999,
  "leitorId": 1
}

### Emprestimo com leitor inexistente (404)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 1,
  "leitorId": 999
}

### Emprestimo com dados invalidos (400)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": "abc"
}

### R3: o cliente nao pode enviar dataPrevista (400)
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 5,
  "leitorId": 4,
  "dataPrevista": "2030-01-01"
}

###############################################################
# 6. DEVOLUCOES
###############################################################

### Devolver emprestimo no prazo (200) - multa deve ser 0
PATCH {{host}}/emprestimos/{{emprestimo1.response.body.dados.id}}/devolucao

### R5 ERRO: devolver novamente o mesmo emprestimo (409 JA_DEVOLVIDO)
PATCH {{host}}/emprestimos/{{emprestimo1.response.body.dados.id}}/devolucao

### Devolver emprestimo inexistente (404)
PATCH {{host}}/emprestimos/999/devolucao

### Id invalido (400)
PATCH {{host}}/emprestimos/abc/devolucao

### R4 (parte 1): emprestimo com retirada ha 20 dias (201)
# Prazo = retirada + 14 dias, entao este emprestimo esta com 6 dias de atraso.
# O campo dataRetirada e opcional; sem ele a API usa a data de hoje.
# @name emprestimoAtrasado
POST {{host}}/emprestimos
Content-Type: application/json

{
  "livroId": 5,
  "leitorId": 4,
  "dataRetirada": "{{$datetime iso8601 -20 d}}"
}

### R4 (parte 2): devolver o emprestimo atrasado (200) - multa deve ser 6 (R$ 1,00 x 6 dias)
PATCH {{host}}/emprestimos/{{emprestimoAtrasado.response.body.dados.id}}/devolucao

###############################################################
# 7. EMPRESTIMOS DO LEITOR
###############################################################

### Todos os emprestimos do leitor 1 (200) - inclui o devolvido
GET {{host}}/leitores/1/emprestimos

### Somente emprestimos em aberto do leitor 1 (200) - lista vazia
GET {{host}}/leitores/1/emprestimos?status=aberto

### Somente emprestimos em aberto do leitor 5 (200) - 3 emprestimos
GET {{host}}/leitores/5/emprestimos?status=aberto

### Filtro invalido (400)
GET {{host}}/leitores/5/emprestimos?status=fechado

### Leitor inexistente (404)
GET {{host}}/leitores/999/emprestimos

###############################################################
# 8. EXCLUSAO DE LIVROS
###############################################################

### R6 ERRO: excluir livro com emprestimo em aberto (409)
DELETE {{host}}/livros/2

### Excluir livro sem emprestimo em aberto (204, sem corpo)
DELETE {{host}}/livros/{{novoLivro.response.body.dados.id}}

### Excluir livro inexistente (404)
DELETE {{host}}/livros/999
